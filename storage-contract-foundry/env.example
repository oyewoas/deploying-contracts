# RPC URLs
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
ALFAJORES_RPC_URL=https://alfajores-forno.celo-testnet.org
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private Keys (NEVER commit these to version control!)
PRIVATE_KEY=your_private_key_here

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here
CELOSCAN_API_KEY=your_celoscan_api_key_here

# Contract verification (set these when verifying contracts)
CONTRACT_ADDRESS=0x...
CHAIN_ID=11155111  # Sepolia: 11155111, Alfajores: 44787, Mainnet: 1
CONSTRUCTOR_ARGS=  # Leave empty if no constructor args

# Test variables
TEST=test_name_pattern  # For running specific tests 